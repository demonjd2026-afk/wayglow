{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "wayglow-valley",
  "post": {
    "entrypoints": {
      "default": {
        "entry": "splash.html",
        "height": "tall"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {},
  "menu": {
    "items": [
      {
        "label": "Wayglow: new post",
        "description": "Create a Wayglow post for tonight's valley.",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/on/menu/new-post"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/on/app/install"
  },
  "scripts": {
    "dev": "npm run watch"
  },
  "permissions": {
    "redis": true,
    "reddit": true,
    "realtime": true,
    "journeys": true
  },
  "scheduler": {
    "tasks": {
      "daily-post": {
        "endpoint": "/internal/cron/daily-post",
        "cron": "5 0 * * *"
      }
    }
  },
  "dev": {
    "subreddit": "wayglow_valley_dev"
  }
}